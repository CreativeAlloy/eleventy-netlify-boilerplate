{# --- The Wasp Alloy: Comments Section Component (Phase 1 Frontend) --- #}
<section class="comments-container" id="comments" data-slug="{{ page.fileSlug }}">
  <div class="comments-header">
    <h3>Comment Threads (<span id="comments-count">0</span>)</h3>
    <small class="comments-subtext">Stateless Federated Authentication. Markdown supported. Zero tracking cookies.</small>
  </div>

  {# --- Comment Sorting Controls (top-level comments only) --- #}
  <div class="comment-sort-controls" id="comment-sort-main" role="group" aria-label="Sort comments">
    <button type="button" class="comment-sort-btn active" data-sort="latest">Latest</button>
    <button type="button" class="comment-sort-btn" data-sort="oldest">Oldest</button>
    <button type="button" class="comment-sort-btn" data-sort="rating">Top Rated</button>
  </div>

  {# --- Thread Modal Dialog --- #}
  <dialog id="thread-dialog" class="thread-dialog" aria-labelledby="thread-dialog-title">
    <div class="thread-dialog-inner">
      <header class="thread-dialog-header">
        <div>
          <h4 id="thread-dialog-title" class="thread-dialog-heading">Comment Thread</h4>
          <small class="thread-dialog-subheading">Thread Discussion</small>
        </div>
        <button type="button" id="thread-dialog-close" class="thread-dialog-close" aria-label="Close thread dialog">&times;</button>
      </header>

      <div id="thread-dialog-parent" class="thread-dialog-parent">
        <!-- Pinned parent comment renders here -->
      </div>

      <div class="thread-dialog-replies-wrap">
        <h5 class="thread-replies-title">Replies</h5>

        {# --- Reply Sorting Controls (independent of the main feed sort) --- #}
        <div class="comment-sort-controls" id="thread-sort-replies" role="group" aria-label="Sort replies">
          <button type="button" class="comment-sort-btn active" data-sort="latest">Latest</button>
          <button type="button" class="comment-sort-btn" data-sort="oldest">Oldest</button>
          <button type="button" class="comment-sort-btn" data-sort="rating">Top Rated</button>
        </div>

        <div id="thread-dialog-replies" class="thread-dialog-replies">
          <!-- Nested replies render here -->
        </div>
      </div>

      {# --- Thread Reply Editor --- #}
      <div class="comment-editor-box thread-reply-editor-box">
        <div class="comment-editor-tabs">
          <button type="button" class="comment-tab active" id="thread-reply-tab-write">Write</button>
          <button type="button" class="comment-tab" id="thread-reply-tab-preview">Preview</button>
        </div>

        <textarea 
          id="thread-reply-input" 
          class="comment-textarea" 
          placeholder="Write a reply..." 
          rows="3" 
          style="resize: vertical; min-height: 80px; max-height: 300px;"></textarea>

        <div id="thread-reply-preview-pane" class="comment-preview-pane" style="display: none;"></div>

        <!-- THIS FOOTER MUST BE INSIDE .thread-reply-editor-box -->
        <div class="comment-editor-footer">
          <div class="comment-auth-status" id="thread-reply-auth-status">
            <!-- Dynamically populated by renderAuthUI() -->
          </div>

          <div class="comment-editor-actions">
            <button type="button" id="thread-reply-submit-btn" class="comment-btn-submit" disabled>Post Reply</button>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  {# --- Native HTML5 Login Modal Dialog --- #}
  <dialog id="login-dialog" class="auth-dialog">
    <h4>Sign in to comment</h4>
    <p>Choose how you'd like to sign in.</p>
    <div class="auth-dialog-options">
      <button type="button" class="auth-pill auth-btn-github" data-provider="github">Sign in with GitHub</button>
      <button type="button" class="auth-pill auth-btn-instagram" data-provider="instagram">Sign in with Instagram</button>
      <button type="button" class="auth-pill auth-btn-discord" data-provider="discord">Sign in with Discord</button>
    </div>
    <button type="button" class="auth-dialog-cancel" id="login-dialog-cancel">Cancel</button>
  </dialog>

  {# --- Comment Editor --- #}
  <div class="comment-editor-box">
    <div class="comment-editor-tabs">
      <button type="button" class="comment-tab active" id="comment-tab-write">Write</button>
      <button type="button" class="comment-tab" id="comment-tab-preview">Preview</button>
    </div>

    <textarea 
      id="comment-input" 
      class="comment-textarea" 
      placeholder="Write a comment..." 
      rows="4" 
      style="resize: vertical; min-height: 100px; max-height: 500px;"></textarea>

    {# --- Live Markdown Preview Pane --- #}
    <div id="comment-preview-pane" class="comment-preview-pane" style="display: none;"></div>

    <div class="comment-editor-footer">
      <div class="comment-auth-status" id="auth-status-container">
        <!-- Dynamically populated by JS: Login button OR User Avatar + Logout -->
      </div>

      <div class="comment-editor-actions">
        <button type="button" id="comment-submit-btn" class="comment-btn-submit" disabled>Post Comment</button>
      </div>
    </div>
  </div>

  {# --- Comments Feed Container --- #}
  <div class="comments-feed" id="comments-feed">
    <!-- Populated dynamically from Neon database -->
  </div>
</section>

{# --- Notifications: floating bell + right-side drawer (the script moves these to <body>) --- #}
<button type="button" id="notif-bell" class="notif-bell" aria-label="Notifications" aria-haspopup="dialog" aria-expanded="false" aria-controls="notifications-drawer" hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a6 6 0 0 0-6 6v3.6c0 .5-.2 1-.5 1.4L4 14.8c-.7.9-.1 2.2 1 2.2h14c1.1 0 1.7-1.3 1-2.2l-1.5-1.8c-.3-.4-.5-.9-.5-1.4V8a6 6 0 0 0-6-6zm0 20a3 3 0 0 0 3-3H9a3 3 0 0 0 3 3z"/></svg>
  <span class="notif-badge" id="notif-badge" hidden>0</span>
</button>

<div id="notif-backdrop" class="notif-backdrop"></div>

<aside id="notifications-drawer" class="notif-drawer" role="dialog" aria-modal="true" aria-labelledby="notif-title" inert>
  <header class="notif-drawer-header">
    <h4 id="notif-title">Notifications</h4>
    <div class="notif-drawer-actions">
      <button type="button" id="notif-mark-all" class="notif-mark-all" disabled>Mark all as read</button>
      <button type="button" id="notif-close" class="notif-close" aria-label="Close notifications">&times;</button>
    </div>
  </header>
  <div id="notif-list" class="notif-list" aria-live="polite">
    <!-- Mini comment cards render here -->
  </div>
</aside>

{# --- Phase 1: Client-Side Engine (Marked.js + DOMPurify + Interactive Logic) --- #}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Elements
  const tabWrite = document.getElementById('comment-tab-write');
  const tabPreview = document.getElementById('comment-tab-preview');
  const textarea = document.getElementById('comment-input');
  const previewPane = document.getElementById('comment-preview-pane');
  const submitBtn = document.getElementById('comment-submit-btn');
  const feed = document.getElementById('comments-feed');
  const countSpan = document.getElementById('comments-count');

  // Thread dialog & sort elements
  const mainSortButtons = document.querySelectorAll('#comment-sort-main .comment-sort-btn');
  const replySortButtons = document.querySelectorAll('#thread-sort-replies .comment-sort-btn');
  const threadDialog = document.getElementById('thread-dialog');
  const threadDialogClose = document.getElementById('thread-dialog-close');
  const threadDialogParent = document.getElementById('thread-dialog-parent');
  const threadDialogReplies = document.getElementById('thread-dialog-replies');
  const threadReplyTabWrite = document.getElementById('thread-reply-tab-write');
  const threadReplyTabPreview = document.getElementById('thread-reply-tab-preview');
  const threadReplyInput = document.getElementById('thread-reply-input');
  const threadReplyPreview = document.getElementById('thread-reply-preview-pane');
  const threadReplySubmitBtn = document.getElementById('thread-reply-submit-btn');
  const threadReplyAuthStatus = document.getElementById('thread-reply-auth-status');

  let currentSort = 'latest';   // top-level comments (sorted server-side)
  let replySort = 'latest';     // replies inside the thread dialog (sorted client-side)
  let activeThreadId = null;
  let cachedComments = [];

  if (!textarea || !tabWrite || !tabPreview) return;

  // 1. Modern marked.js configuration with autolinks & custom anchor text
  const mentionExtension = {
    name: 'mention',
    level: 'inline',
    start(src) { return src.match(/\[@/)?.index; },
    tokenizer(src) {
      const rule = /^\[@([^\]]+)\]/;
      const match = rule.exec(src);
      if (match) {
        return {
          type: 'mention',
          raw: match[0],
          name: match[1]
        };
      }
    },
    renderer(token) {
      const name = token.name;
      const user = cachedComments.find(c => c.author_name.toLowerCase() === name.toLowerCase() && c.author_url);
      if (user) {
        return `<a href="${esc(user.author_url)}" target="_blank" rel="noopener noreferrer" class="mention-tag">@${esc(name)}</a>`;
      }
      return `<span class="mention-tag">@${esc(name)}</span>`;
    }
  };

  marked.use({
    gfm: true,
    breaks: true,
    extensions: [mentionExtension],
    renderer: {
      link(token) {
        // Modern marked passes an object: { href, title, text }
        // Fallback for older signatures if ever downgraded: (href, title, text)
        let href = typeof token === 'object' && token !== null ? token.href : arguments[0];
        let title = typeof token === 'object' && token !== null ? token.title : arguments[1];
        let text = typeof token === 'object' && token !== null ? token.text : arguments[2];

        // If it's a bare URL without [text], display the href itself
        const displayText = text || href;
        const titleAttr = title ? ` title="${title}"` : '';

        return `<a href="${href}" target="_blank" rel="noopener noreferrer"${titleAttr}>${displayText}</a>`;
      }
    }
  });

  // 2. Tab Switching Logic
  tabWrite.addEventListener('click', () => {
    tabWrite.classList.add('active');
    tabPreview.classList.remove('active');
    previewPane.style.display = 'none';
    textarea.style.display = 'block';
    textarea.focus();
  });

  tabPreview.addEventListener('click', () => {
    tabPreview.classList.add('active');
    tabWrite.classList.remove('active');

    const rawMarkdown = textarea.value.trim();
    if (rawMarkdown) {
      previewPane.innerHTML = safeMd(rawMarkdown);
    } else {
      previewPane.innerHTML = '<p><em>Nothing to preview. Type something in the Write tab first!</em></p>';
    }

    textarea.style.display = 'none';
    previewPane.style.display = 'block';
  });

  if (threadReplyTabWrite && threadReplyTabPreview && threadReplyInput && threadReplyPreview) {
    threadReplyTabWrite.addEventListener('click', () => {
      threadReplyTabWrite.classList.add('active');
      threadReplyTabPreview.classList.remove('active');
      threadReplyPreview.style.display = 'none';
      threadReplyInput.style.display = 'block';
      threadReplyInput.focus();
    });

    threadReplyTabPreview.addEventListener('click', () => {
      threadReplyTabPreview.classList.add('active');
      threadReplyTabWrite.classList.remove('active');
      const rawMarkdown = threadReplyInput.value.trim();
      if (rawMarkdown) {
        threadReplyPreview.innerHTML = safeMd(rawMarkdown);
      } else {
        threadReplyPreview.innerHTML = '<p><em>Nothing to preview. Type something in the Write tab first!</em></p>';
      }
      threadReplyInput.style.display = 'none';
      threadReplyPreview.style.display = 'block';
    });
  }

  const postSlug = document.getElementById('comments').getAttribute('data-slug');

  // List of verified Author Instagram IDs (expandable array)
  const AUTHOR_IG_IDS = ['17841463559161115'];

  // Stored value -> display text. The database only ever holds the keys.
  const BADGE_LABELS = {
    wonderful: '❤️ Wonderful Take!',
    dishonor: '💔 Badge of Dishonor.'
  };

  // Moderator badge picker: close any open menu on outside click or Escape.
  function closeBadgeMenus() {
    document.querySelectorAll('.badge-menu').forEach(m => {
      m.previousElementSibling?.setAttribute('aria-expanded', 'false');
      m.remove();
    });
  }
  document.addEventListener('click', closeBadgeMenus);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeBadgeMenus(); });
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const safeMd = (md) => DOMPurify.sanitize(marked.parse(md), { ADD_ATTR: ['target', 'class'] });

  function avatarFor(provider, userId, name, avatarUrl) {
    // 1. If a real avatar URL is stored in the database (Discord CDN, Google, etc.), render it directly!
    if (avatarUrl) {
      return `<img src="${esc(avatarUrl)}" alt="${esc(name)}" class="comment-avatar-slot" style="object-fit: cover; border: 1px solid var(--primary);">`;
    }
    // 2. GitHub fallback using predictable public CDN
    if (provider === 'github' && userId && userId !== 'guest') {
      return `<img src="https://avatars.githubusercontent.com/u/${encodeURIComponent(userId)}?v=4" alt="${esc(name)}" class="comment-avatar-slot" style="object-fit: cover; border: 1px solid var(--primary);">`;
    }
    // 3. Fallback initials with provider-specific gradient styling (Instagram, or Discord without avatar)
    const initial = esc((name || '?').charAt(0).toUpperCase());
    const providerClass = provider === 'discord' ? 'avatar-discord' : provider === 'instagram' ? 'avatar-instagram' : '';
    return `<div class="comment-avatar-slot ${providerClass}" aria-hidden="true">${initial}</div>`;
  }

  // Helper to render star strings
  // --- Comment ratings: 0.0 to 5.0 in 0.5 steps, shown as the average of everyone's votes ---
  const fmtAvg = (n) => (Math.round(n * 10) / 10).toFixed(1);

  function ratingTitle(avg, count, mine) {
    const base = count > 0
      ? `${fmtAvg(avg)} average from ${count} rating${count === 1 ? '' : 's'}`
      : 'No ratings yet';
    return (mine === null || mine === undefined)
      ? base
      : `${base} · Your rating: ${Number(mine).toFixed(1)}`;
  }

  function ratingSummaryHtml(avg, count) {
    return count > 0
      ? `<span class="rating-value">${fmtAvg(avg)}</span><span class="rating-count">(${count})</span>`
      : '<span class="rating-none">No ratings yet</span>';
  }

  function ratingHtml(c) {
    const avg = Number(c.rating_avg) || 0;
    const count = Number(c.rating_count) || 0;
    const mine = (c.my_rating === null || c.my_rating === undefined) ? null : Number(c.my_rating);

    // You can't rate your own comment (the server enforces this too)
    const isOwn = currentUser && currentUser.provider === c.provider &&
      String(currentUser.provider_user_id) === String(c.provider_user_id);
    const canRate = !isOwn;

    let stars = '';
    for (let i = 0; i < 5; i++) {
      const fill = Math.max(0, Math.min(1, avg - i)) * 100; // 3.8 -> 100, 100, 100, 80, 0
      const hits = canRate
        ? `<button type="button" class="rating-hit rating-hit-left" data-value="${i + 0.5}" aria-label="Rate ${(i + 0.5).toFixed(1)} out of 5"></button>` +
          `<button type="button" class="rating-hit rating-hit-right" data-value="${i + 1}" aria-label="Rate ${(i + 1).toFixed(1)} out of 5"></button>`
        : '';
      stars += `<span class="rating-star" style="--fill:${fill}%">★${hits}</span>`;
    }
    const zero = canRate
      ? '<button type="button" class="rating-zero" data-value="0" aria-label="Rate 0.0 out of 5" title="Rate 0.0">0</button>'
      : '';

    return `
      <div class="comment-rating" title="${esc(ratingTitle(avg, count, mine))}">
        <div class="rating${canRate ? ' rating-interactive' : ''}" data-id="${esc(c.id)}" data-avg="${avg}" role="group" aria-label="Rating">
          ${zero}<span class="rating-stars">${stars}</span>
        </div>
        <span class="rating-summary">${ratingSummaryHtml(avg, count)}</span>
      </div>`;
  }

  function paintRating(box, value) {
    box.querySelectorAll('.rating-star').forEach((star, i) => {
      star.style.setProperty('--fill', `${Math.max(0, Math.min(1, value - i)) * 100}%`);
    });
  }

  // --- Thread bell (subscribe / mute) ---
  // One outline path: stroke-only when muted, filled + glowing when subscribed (see CSS).
  const BELL_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a6 6 0 0 0-6 6v3.6c0 .5-.2 1-.5 1.4L4 14.8c-.7.9-.1 2.2 1 2.2h14c1.1 0 1.7-1.3 1-2.2l-1.5-1.8c-.3-.4-.5-.9-.5-1.4V8a6 6 0 0 0-6-6zm0 20a3 3 0 0 0 3-3H9a3 3 0 0 0 3 3z"/></svg>';

  const bellLabel = (on) => on
    ? 'Subscribed to thread replies (Click to mute)'
    : 'Subscribe to thread replies';

  function bellButtonHtml(c) {
    const on = c.is_subscribed === true;
    return `<button type="button" class="thread-bell-btn${on ? ' active' : ''}" data-id="${esc(c.id)}" aria-pressed="${on}" title="${bellLabel(on)}" aria-label="${bellLabel(on)}">${BELL_SVG}</button>`;
  }

  function setBellState(btn, on) {
    btn.classList.toggle('active', on);
    btn.setAttribute('aria-pressed', String(on));
    btn.title = bellLabel(on);
    btn.setAttribute('aria-label', bellLabel(on));
  }

  function buildCommentCard(c, isParentFeed = false) {
    const card = document.createElement('article');
    card.className = c.is_deleted ? 'comment-card comment-tombstone' : 'comment-card';
    card.setAttribute('data-id', c.id);

    if (c.is_deleted) {
      let replyToggle = '';
      if (isParentFeed) {
        const count = Number(c.reply_count || 0);
        replyToggle = `
          <div class="comment-thread-actions">
            <button type="button" class="comment-reply-toggle" data-id="${c.id}" aria-expanded="false" aria-controls="thread-dialog">
              ${count} Replies ⬇
            </button>
          </div>
        `;
      }
      card.innerHTML = `<div class="comment-content"><em>${esc(c.comment_body)}</em></div>${replyToggle}`;
      return card;
    }

    const dateStr = new Date(c.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    const parsedContent = safeMd(c.comment_body);
    const badgeLabel = BADGE_LABELS[c.mod_badge];
    const badgeHtml = badgeLabel ? `<footer class="comment-card-footer"><span class="twa-mod-badge badge-${esc(c.mod_badge)}">${esc(badgeLabel)}</span></footer>` : '';
    const avatarHtml = avatarFor(c.provider, c.provider_user_id, c.author_name, c.avatar_url);

    const profileUrl = c.author_url || '';
    const authorHtml = profileUrl
      ? `<a href="${profileUrl}" target="_blank" rel="noopener noreferrer" class="comment-author-link"><strong class="comment-author">${esc(c.author_name)}</strong></a>`
      : `<strong class="comment-author">${esc(c.author_name)}</strong>`;

    const isSiteAuthor = c.provider === 'instagram' && AUTHOR_IG_IDS.includes(String(c.provider_user_id));
    const authorTag = isSiteAuthor
      ? '<span class="provider-tag role-author">Author</span>'
      : (c.is_admin ? '<span class="provider-tag role-admin">Admin</span>' : '');

    const canDelete = currentUser && (
      currentUser.role === 'moderator' ||
      currentUser.role === 'author' ||
      (currentUser.provider === c.provider && String(currentUser.provider_user_id) === String(c.provider_user_id))
    );

    const deleteBtnHtml = canDelete
      ? `<button type="button" class="btn-delete-comment" data-id="${c.id}" aria-label="Delete comment">Delete</button>`
      : '';

    const canBadge = currentUser && (currentUser.role === 'moderator' || currentUser.role === 'author');
    const badgeBtnHtml = canBadge
      ? `<span class="badge-picker"><button type="button" class="btn-badge-comment" data-id="${c.id}" aria-haspopup="true" aria-expanded="false">Badge</button></span>`
      : '';

    let replyToggleHtml = '';
    if (isParentFeed) {
      const count = Number(c.reply_count || 0);
      replyToggleHtml = `
        <div class="comment-thread-actions">
          ${bellButtonHtml(c)}
          <button type="button" class="comment-reply-toggle" data-id="${c.id}" aria-expanded="false" aria-controls="thread-dialog">
            ${count} Replies ⬇
          </button>
        </div>
      `;
    }

    card.innerHTML = `
      <header class="comment-card-header">
        ${avatarHtml}
        <div class="comment-user-info">
          ${authorHtml}
          <span class="provider-tag provider-${esc(c.provider)}">${esc(c.provider)}</span>
          ${authorTag}
          <time datetime="${c.created_at}"><small>${dateStr}</small></time>
          ${deleteBtnHtml}
          ${badgeBtnHtml}
        </div>
        ${ratingHtml(c)}
      </header>
      <div class="comment-content">
        ${parsedContent}
      </div>
      ${badgeHtml}
      ${replyToggleHtml}
    `;
    return card;
  }

  // --- Sorting helpers ---
  const setActiveSort = (buttons, value) =>
    buttons.forEach(b => b.classList.toggle('active', (b.dataset.sort || 'latest') === value));

  // Mirrors get-comments.js: unrated comments rank last for "rating", ties fall back to newest first.
  function sortReplies(list, mode) {
    const time = (c) => new Date(c.created_at).getTime();
    const score = (c) => (Number(c.rating_count) > 0 ? Number(c.rating_avg) : -1);
    return [...list].sort((a, b) => {
      if (mode === 'oldest') return time(a) - time(b);
      if (mode === 'rating') {
        const d = score(b) - score(a);
        if (d !== 0) return d;
      }
      return time(b) - time(a);
    });
  }

  function resetSorts() {
    currentSort = 'latest';
    replySort = 'latest';
    setActiveSort(mainSortButtons, 'latest');
    setActiveSort(replySortButtons, 'latest');
  }

  function renderThread(parent) {
    if (!threadDialogParent || !threadDialogReplies) return;
    threadDialogParent.innerHTML = '';
    threadDialogParent.appendChild(buildCommentCard(parent, false));

    const replies = sortReplies(
      cachedComments.filter(c => Number(c.parent_id) === Number(parent.id)),
      replySort
    );
    threadDialogReplies.innerHTML = '';

    if (replies.length === 0) {
      threadDialogReplies.innerHTML = '<p class="thread-no-replies"><em>No replies yet. Be the first to reply!</em></p>';
    } else {
      for (const r of replies) {
        threadDialogReplies.appendChild(buildCommentCard(r, false));
      }
    }
  }

  // Hover / keyboard-focus preview (attached to document so modal and feed both respond)
  ['mouseover', 'focusin'].forEach(evt => document.addEventListener(evt, (e) => {
    const hit = e.target.closest('.rating button[data-value]');
    if (hit) paintRating(hit.closest('.rating'), Number(hit.dataset.value));
  }));
  ['mouseout', 'focusout'].forEach(evt => document.addEventListener(evt, (e) => {
    const box = e.target.closest('.rating-interactive');
    if (box && !box.contains(e.relatedTarget)) paintRating(box, Number(box.dataset.avg) || 0);
  }));

  // Click a half or full star (or the 0 button) to rate across feed and modal
  document.addEventListener('click', async (e) => {
    const hit = e.target.closest('.rating button[data-value]');
    if (!hit) return;
    if (!currentUser) { loginDialog?.showModal(); return; }

    const box = hit.closest('.rating');
    box.classList.add('rating-saving');
    try {
      const res = await fetch('/.netlify/functions/set-rating', {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify({ comment_id: box.dataset.id, rating: Number(hit.dataset.value) })
      });
      if (res.status === 401) return handleExpired();
      if (res.status === 403) { alert("You can't rate your own comment."); return; }
      if (!res.ok) throw new Error('Rating failed');
      const data = await res.json();

      // The same comment can be on screen twice (feed card + pinned parent in the thread dialog)
      document.querySelectorAll(`.rating[data-id="${CSS.escape(String(box.dataset.id))}"]`).forEach(b => {
        b.dataset.avg = data.rating_avg;
        paintRating(b, data.rating_avg);
        const wrap = b.closest('.comment-rating');
        wrap.querySelector('.rating-summary').innerHTML = ratingSummaryHtml(data.rating_avg, data.rating_count);
        wrap.title = ratingTitle(data.rating_avg, data.rating_count, data.my_rating);
      });

      const cached = cachedComments.find(x => String(x.id) === String(box.dataset.id));
      if (cached) {
        cached.rating_avg = data.rating_avg;
        cached.rating_count = data.rating_count;
        cached.my_rating = data.my_rating;
      }
    } catch (err) {
      alert('Error saving rating.');
      console.error(err);
    } finally {
      box.classList.remove('rating-saving');
    }
  });

  // Main feed sort: re-fetches top-level comments; never touches the reply sort
  mainSortButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      currentSort = btn.dataset.sort || 'latest';
      setActiveSort(mainSortButtons, currentSort);
      await loadComments();
    });
  });

  // Reply sort: re-sorts the open thread only; never touches the main feed
  replySortButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      replySort = btn.dataset.sort || 'latest';
      setActiveSort(replySortButtons, replySort);
      const parent = cachedComments.find(c => Number(c.id) === Number(activeThreadId));
      if (parent) renderThread(parent);
    });
  });

  // Leaving the page resets both sorts. A fresh load already starts at Latest; this also
  // covers the browser back/forward cache, which would otherwise restore the old state.
  window.addEventListener('pagehide', resetSorts);
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    resetSorts();
    if (threadDialog?.open) threadDialog.close();
    loadComments();
  });

  // Thread dialog close listeners
  threadDialogClose?.addEventListener('click', () => threadDialog?.close());
  threadDialog?.addEventListener('click', (e) => {
    if (e.target === threadDialog) threadDialog.close();
  });
  threadDialog?.addEventListener('close', () => {
    activeThreadId = null;
    replySort = 'latest';
    setActiveSort(replySortButtons, 'latest');
    document.querySelectorAll('.comment-reply-toggle').forEach(t => t.setAttribute('aria-expanded', 'false'));
  });

  // 1. Fetch & Render Comments on Page Load from Neon Database
  async function loadComments() {
    try {
      const res = await fetch(`/.netlify/functions/get-comments?slug=${encodeURIComponent(postSlug)}&sort=${encodeURIComponent(currentSort)}`, {
        headers: currentUser?.token ? { 'Authorization': `Bearer ${currentUser.token}` } : {}
      });
      if (!res.ok) return;
      const data = await res.json();

      cachedComments = data.comments || [];
      feed.innerHTML = ''; // Clear feed

      // Only top-level comments in main feed
      const parentComments = cachedComments.filter(c => c.parent_id === null || c.parent_id === undefined);

      if (countSpan) countSpan.textContent = parentComments.length;

      for (const parent of parentComments) {
        feed.appendChild(buildCommentCard(parent, true));
      }

      // If thread modal is currently open, refresh its contents in-place
      if (activeThreadId !== null && threadDialog?.open) {
        const activeParent = cachedComments.find(c => Number(c.id) === Number(activeThreadId));
        if (activeParent) {
          renderThread(activeParent);
        }
      }

      // Attach click listeners to all reply toggle buttons
      document.querySelectorAll('.comment-reply-toggle').forEach(btn => {
        btn.addEventListener('click', () => openThread(Number(btn.getAttribute('data-id'))));
      });

      // Attach click listeners to all active [Delete] buttons
      document.querySelectorAll('.btn-delete-comment').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const commentId = e.target.getAttribute('data-id');
          if (!confirm('Are you sure you want to delete this comment?')) return;

          e.target.disabled = true;
          e.target.textContent = '[Deleting...]';

          try {
            const deleteRes = await fetch('/.netlify/functions/delete-comment', {
              method: 'POST',
              headers: authHeaders(),
              body: JSON.stringify({
                comment_id: commentId
              })
            });

            if (deleteRes.status === 401) return handleExpired();
            if (!deleteRes.ok) throw new Error('Deletion failed');
            await loadComments(); // Reload to render tombstone immediately
          } catch (err) {
            alert('Error deleting comment.');
            console.error(err);
            e.target.disabled = false;
            e.target.textContent = '[Delete]';
          }
        });
      });

      // Attach click listeners to all [Badge] pickers (moderators only)
      document.querySelectorAll('.btn-badge-comment').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const picker = btn.parentElement;
          const wasOpen = !!picker.querySelector('.badge-menu');
          closeBadgeMenus();
          if (wasOpen) return;

          const menu = document.createElement('div');
          menu.className = 'badge-menu';
          menu.setAttribute('role', 'menu');
          menu.innerHTML = `
            <button type="button" role="menuitem" data-badge="wonderful">${BADGE_LABELS.wonderful}</button>
            <button type="button" role="menuitem" data-badge="dishonor">${BADGE_LABELS.dishonor}</button>
            <button type="button" role="menuitem" data-badge="" class="badge-menu-remove">Remove badge</button>
          `;
          picker.appendChild(menu);
          btn.setAttribute('aria-expanded', 'true');

          menu.addEventListener('click', async (ev) => {
            ev.stopPropagation();
            const opt = ev.target.closest('button[data-badge]');
            if (!opt) return;

            menu.querySelectorAll('button').forEach(b => { b.disabled = true; });
            opt.textContent = 'Saving...';

            try {
              const res = await fetch('/.netlify/functions/set-badge', {
                method: 'POST',
                headers: authHeaders(),
                body: JSON.stringify({
                  comment_id: btn.getAttribute('data-id'),
                  badge: opt.getAttribute('data-badge') || null
                })
              });
              if (res.status === 401) return handleExpired();
              if (!res.ok) throw new Error('Badge update failed');
              await loadComments(); // Re-render with the new footer
            } catch (err) {
              alert('Error updating badge.');
              console.error(err);
              closeBadgeMenus();
            }
          });
        });
      });

      consumePendingThread();
    } catch (err) {
      console.error("Failed to load comments:", err);
    }
  }

  // --- AUTHENTICATION STATE MANAGEMENT ---
  const authStatusContainer = document.getElementById('auth-status-container');
  let currentUser = JSON.parse(localStorage.getItem('twa_user') || 'null');

  // Treat old or tampered sessions missing a cryptographic token as logged out
  if (currentUser && !currentUser.token) {
    localStorage.removeItem('twa_user');
    currentUser = null;
  }

  const authHeaders = () => ({
    'Content-Type': 'application/json',
    'Authorization': `Bearer ${currentUser?.token || ''}`
  });

  function handleExpired() {
    localStorage.removeItem('twa_user');
    currentUser = null;
    renderAuthUI();
    loadComments();
    alert('Your session expired. Please sign in again.');
  }

  // Wire the Login Dialog modal once
  const loginDialog = document.getElementById('login-dialog');
  if (loginDialog) {
    loginDialog.querySelectorAll('[data-provider]').forEach(btn => {
      btn.addEventListener('click', () => {
        window.open(`/.netlify/functions/auth?action=login&provider=${btn.dataset.provider}`, 'twaAuth', 'width=500,height=600');
        loginDialog.close();
      });
    });
    document.getElementById('login-dialog-cancel')?.addEventListener('click', () => loginDialog.close());
    loginDialog.addEventListener('click', (e) => { if (e.target === loginDialog) loginDialog.close(); });
  }

  function renderAuthUI() {
    if (currentUser) {
      // User is logged in
      const roleBadge =
        currentUser.role === 'moderator' ? '<span class="provider-tag role-admin">Admin</span>' :
        currentUser.role === 'author'    ? '<span class="provider-tag role-author">Author</span>' : '';

      const avatar = currentUser.avatar_url
        ? `<img src="${esc(currentUser.avatar_url)}" alt="Avatar" class="auth-user-avatar">`
        : `<span class="auth-user-avatar avatar-${esc(currentUser.provider)}" aria-hidden="true">${esc((currentUser.username || '?').charAt(0).toUpperCase())}</span>`;

      authStatusContainer.innerHTML = `
        ${avatar}
        <span class="auth-pill provider-${esc(currentUser.provider)}">${esc(currentUser.username)}</span>
        ${roleBadge}
        <button type="button" id="btn-logout" class="btn-logout">Log Out</button>
      `;

      document.getElementById('btn-logout').addEventListener('click', () => {
        localStorage.removeItem('twa_user');
        currentUser = null;
        renderAuthUI();
        loadComments();
      });

      submitBtn.disabled = false;
      textarea.disabled = false;
      textarea.placeholder = "Write a comment...";

      if (threadReplySubmitBtn && threadReplyInput && threadReplyAuthStatus) {
        threadReplySubmitBtn.disabled = false;
        threadReplyInput.disabled = false;
        threadReplyInput.placeholder = "Write a reply...";
        threadReplyAuthStatus.innerHTML = authStatusContainer.innerHTML;
        threadReplyAuthStatus.querySelector('.btn-logout')?.addEventListener('click', () => {
          localStorage.removeItem('twa_user');
          currentUser = null;
          renderAuthUI();
          loadComments();
        });
      }
    } else {
      // User is NOT logged in (Clean Single Sign In button triggering modal)
      const signinHtml = `<button type="button" class="auth-pill btn-trigger-signin">Sign in</button>`;
      authStatusContainer.innerHTML = signinHtml;
      document.querySelectorAll('.btn-trigger-signin').forEach(b => {
        b.addEventListener('click', () => loginDialog?.showModal());
      });

      submitBtn.disabled = true;
      textarea.disabled = true;
      textarea.placeholder = "Please sign in to join the discussion...";

      if (threadReplySubmitBtn && threadReplyInput && threadReplyAuthStatus) {
        threadReplySubmitBtn.disabled = true;
        threadReplyInput.disabled = true;
        threadReplyInput.placeholder = "Please sign in to reply...";
        threadReplyAuthStatus.innerHTML = signinHtml;
        threadReplyAuthStatus.querySelector('.btn-trigger-signin')?.addEventListener('click', () => loginDialog?.showModal());
      }
    }

    syncNotifUI();
  }

  // Listen for the secure payload from the popup window
  window.addEventListener('message', (event) => {
    if (event.origin !== window.location.origin) return;
    if (event.data && event.data.type === 'TWA_AUTH_SUCCESS') {
      currentUser = event.data.data;
      localStorage.setItem('twa_user', JSON.stringify(currentUser));
      renderAuthUI();
      loadComments();
    }
  });

  // =========================================================================
  // THREAD OPENING, BELL SUBSCRIPTIONS & NOTIFICATIONS DRAWER
  // (must stay ABOVE the "Initialize UI on load" calls: it declares consts that
  //  renderAuthUI() -> syncNotifUI() touches on first run)
  // =========================================================================
  const POST_URL = (slug) => `/posts/${encodeURIComponent(slug)}/`; // adjust if posts use custom permalinks

  const notifBell = document.getElementById('notif-bell');
  const notifBadge = document.getElementById('notif-badge');
  const notifBackdrop = document.getElementById('notif-backdrop');
  const notifDrawer = document.getElementById('notifications-drawer');
  const notifList = document.getElementById('notif-list');
  const notifMarkAll = document.getElementById('notif-mark-all');
  const notifClose = document.getElementById('notif-close');
  const notifReady = !!(notifBell && notifBackdrop && notifDrawer && notifList && notifMarkAll && notifClose);

  // Re-parent to <body> so no ancestor transform/filter can break position: fixed
  if (notifReady) [notifBell, notifBackdrop, notifDrawer].forEach(el => document.body.appendChild(el));

  let notifications = [];
  let notifUnread = 0;

  // ?thread=ID in the URL = "open this thread once comments have loaded"
  let pendingThreadId = (() => {
    const n = Number(new URLSearchParams(window.location.search).get('thread'));
    return Number.isInteger(n) && n > 0 ? n : null;
  })();

  // Shared by the "N Replies" buttons, notification clicks and ?thread= deep-links
  function openThread(parentId) {
    const parent = cachedComments.find(c => Number(c.id) === Number(parentId));
    if (!parent) return false;

    activeThreadId = Number(parentId);
    replySort = 'latest';
    setActiveSort(replySortButtons, 'latest');
    document.querySelectorAll('.comment-reply-toggle').forEach(t => {
      t.setAttribute('aria-expanded', String(Number(t.dataset.id) === activeThreadId));
    });

    renderThread(parent);
    if (threadReplyInput) {
      threadReplyInput.value = '';
      threadReplyTabWrite?.click();
    }
    if (threadDialog && !threadDialog.open) threadDialog.showModal();
    return true;
  }

  function consumePendingThread() {
    if (pendingThreadId === null) return;
    const id = pendingThreadId;
    pendingThreadId = null;
    openThread(id);

    // Drop ?thread= so a refresh doesn't re-open the dialog
    const url = new URL(window.location.href);
    url.searchParams.delete('thread');
    history.replaceState(null, '', url.pathname + url.search + url.hash);
  }

  // --- Bell on parent comments (delegated: survives every loadComments() re-render) ---
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.thread-bell-btn');
    if (!btn) return;
    if (!currentUser) { loginDialog?.showModal(); return; }
    if (btn.disabled) return;

    btn.disabled = true;
    try {
      const res = await fetch('/.netlify/functions/toggle-subscription', {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify({ parent_id: Number(btn.dataset.id) })
      });
      if (res.status === 401) return handleExpired();
      if (!res.ok) throw new Error('Subscription toggle failed');
      const data = await res.json();

      setBellState(btn, data.is_subscribed === true);
      const cached = cachedComments.find(x => Number(x.id) === Number(btn.dataset.id));
      if (cached) cached.is_subscribed = data.is_subscribed === true;
    } catch (err) {
      alert('Error updating thread subscription.');
      console.error(err);
    } finally {
      btn.disabled = false;
    }
  });

  // --- Notifications drawer ---
  const relTime = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
  function timeAgo(iso) {
    const secs = Math.round((new Date(iso).getTime() - Date.now()) / 1000);
    const units = [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]];
    for (const [unit, size] of units) {
      if (Math.abs(secs) >= size) return relTime.format(Math.round(secs / size), unit);
    }
    return 'just now';
  }

  // Markdown -> sanitized HTML -> plain text (parsed inertly, so no images/scripts load)
  function notifSnippet(md) {
    const html = safeMd(md || '');
    const text = new DOMParser().parseFromString(html, 'text/html').body.textContent || '';
    return text.replace(/\s+/g, ' ').trim();
  }

  function updateBadge() {
    if (!notifBadge || !notifBell) return;
    notifBadge.textContent = notifUnread > 99 ? '99+' : String(notifUnread);
    notifBadge.hidden = notifUnread <= 0;
    notifBell.setAttribute('aria-label', notifUnread > 0 ? `Notifications (${notifUnread} unread)` : 'Notifications');
  }

  function buildNotifCard(n) {
    const card = document.createElement('article');
    card.className = 'notif-card' + (n.is_read ? '' : ' unread');
    card.setAttribute('data-id', n.id);

    const authorHtml = n.author_url
      ? `<a href="${esc(n.author_url)}" target="_blank" rel="noopener noreferrer" class="comment-author-link"><strong class="comment-author">${esc(n.author_name)}</strong></a>`
      : `<strong class="comment-author">${esc(n.author_name)}</strong>`;

    card.innerHTML = `
      <header class="notif-card-header">
        ${avatarFor(n.provider, n.provider_user_id, n.author_name, n.avatar_url)}
        <div class="notif-card-meta">
          ${authorHtml}
          <span class="provider-tag provider-${esc(n.provider)}">${esc(n.provider)}</span>
          <time datetime="${esc(n.created_at)}"><small>${esc(timeAgo(n.created_at))}</small></time>
        </div>
        ${n.is_read ? '' : '<span class="notif-dot" role="img" aria-label="Unread"></span>'}
      </header>
      <button type="button" class="notif-card-open" title="Open thread">
        <span class="notif-snippet">${esc(notifSnippet(n.comment_body))}</span>
      </button>
    `;
    return card;
  }

  function renderNotifications() {
    if (!notifReady) return;
    notifList.innerHTML = '';
    if (notifications.length === 0) {
      notifList.innerHTML = '<p class="notif-empty"><em>No notifications yet.</em></p>';
    } else {
      notifications.forEach(n => notifList.appendChild(buildNotifCard(n)));
    }
    notifMarkAll.disabled = notifUnread === 0;
    updateBadge();
  }

  async function fetchNotifications() {
    if (!notifReady || !currentUser) return;
    try {
      const res = await fetch('/.netlify/functions/get-notifications', { headers: authHeaders() });
      if (res.status === 401) {
        // Expired session: sign out quietly (no alert on page load)
        localStorage.removeItem('twa_user');
        currentUser = null;
        renderAuthUI();
        loadComments();
        return;
      }
      if (!res.ok) return;
      const data = await res.json();
      notifications = data.notifications || [];
      notifUnread = Number(data.unread_count) || 0;
      renderNotifications();
    } catch (err) {
      console.error('Failed to load notifications:', err);
    }
  }

  // Keep-alive so a mark-read still completes when we navigate away right after
  async function markNotificationsRead(payload) {
    try {
      const res = await fetch('/.netlify/functions/mark-notifications-read', {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify(payload),
        keepalive: true
      });
      if (res.status === 401) { handleExpired(); return false; }
      return res.ok;
    } catch (err) {
      console.error('Failed to mark notifications read:', err);
      return false;
    }
  }

  function openNotifDrawer() {
    if (!notifReady) return;
    notifDrawer.removeAttribute('inert');
    notifDrawer.classList.add('open');
    notifBackdrop.classList.add('open');
    notifBell.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(() => notifClose.focus());
    fetchNotifications();
  }

  function closeNotifDrawer() {
    if (!notifReady) return;
    const wasOpen = notifDrawer.classList.contains('open');
    notifDrawer.classList.remove('open');
    notifBackdrop.classList.remove('open');
    notifDrawer.setAttribute('inert', '');
    notifBell.setAttribute('aria-expanded', 'false');
    if (wasOpen) notifBell.focus();
  }

  // Show/hide the bell and load the count; called from renderAuthUI()
  function syncNotifUI() {
    if (!notifReady) return;
    if (currentUser) {
      notifBell.hidden = false;
      fetchNotifications();
    } else {
      closeNotifDrawer();
      notifBell.hidden = true;
      notifications = [];
      notifUnread = 0;
      renderNotifications();
    }
  }

  function openNotification(n) {
    if (!n.is_read) {
      n.is_read = true;
      notifUnread = Math.max(0, notifUnread - 1);
      markNotificationsRead({ notification_id: n.id });
    }

    if (n.post_slug === postSlug) {
      // Same post: refresh first so a brand-new reply is in the thread, then open it
      closeNotifDrawer();
      renderNotifications();
      loadComments().then(() => openThread(n.parent_id));
    } else {
      window.location.href = `${POST_URL(n.post_slug)}?thread=${encodeURIComponent(n.parent_id)}`;
    }
  }

  if (notifReady) {
    notifBell.addEventListener('click', () => {
      if (notifDrawer.classList.contains('open')) closeNotifDrawer(); else openNotifDrawer();
    });
    notifClose.addEventListener('click', closeNotifDrawer);
    notifBackdrop.addEventListener('click', closeNotifDrawer);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && notifDrawer.classList.contains('open')) closeNotifDrawer();
    });

    notifMarkAll.addEventListener('click', async () => {
      if (notifUnread === 0) return;
      notifMarkAll.disabled = true;
      const ok = await markNotificationsRead({ all: true });
      if (ok) {
        notifications.forEach(n => { n.is_read = true; });
        notifUnread = 0;
        renderNotifications();
      } else {
        notifMarkAll.disabled = false;
      }
    });

    // Whole card is clickable (profile links keep working); the inner button covers the keyboard
    notifList.addEventListener('click', (e) => {
      if (e.target.closest('a')) return;
      const card = e.target.closest('.notif-card');
      if (!card) return;
      const n = notifications.find(x => Number(x.id) === Number(card.dataset.id));
      if (n) openNotification(n);
    });

    // Pick up replies that arrived while the tab was in the background
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && currentUser) fetchNotifications();
    });
  }

  // Initialize UI on load
  renderAuthUI();
  loadComments();

  // Helper to submit comment or reply
  async function submitComment(bodyText, parentId, btn, inputElem, writeTab) {
    if (!currentUser) return;
    const text = bodyText.trim();
    if (!text) {
      alert('Please enter some text before posting.');
      return;
    }

    btn.disabled = true;
    const originalText = btn.textContent;
    btn.textContent = 'Posting...';

    try {
      const res = await fetch('/.netlify/functions/post-comment', {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify({
          slug: postSlug,
          comment_body: text,
          parent_id: parentId
        })
      });

      if (res.status === 401) return handleExpired();
      if (res.status === 429) {
        const msg = await res.text();
        alert(msg);
        return;
      }
      if (!res.ok) throw new Error(`Submission failed: ${res.status} ${await res.text()}`);

      inputElem.value = '';
      writeTab?.click();
      await loadComments();
    } catch (err) {
      alert(err.message || 'Error posting comment.');
      console.error(err);
    } finally {
      btn.disabled = false;
      btn.textContent = originalText;
    }
  }

  // --- Main Top-Level Comment Submission ---
  submitBtn.addEventListener('click', () => {
    submitComment(textarea.value, null, submitBtn, textarea, tabWrite);
  });

  // --- Dedicated Thread Modal Reply Submission ---
  threadReplySubmitBtn?.addEventListener('click', () => {
    if (!activeThreadId) return;
    submitComment(threadReplyInput.value, activeThreadId, threadReplySubmitBtn, threadReplyInput, threadReplyTabWrite);
  });

  // =========================================================================
  // LIVE AUTOCOMPLETE MENTION POPOVER
  // =========================================================================
  let mentionPopup = document.createElement('div');
  mentionPopup.className = 'mention-autocomplete-menu';
  mentionPopup.style.display = 'none';
  mentionPopup.setAttribute('role', 'listbox');
  document.body.appendChild(mentionPopup);

  let activeMentionTarget = null;
  let mentionOptions = [];
  let mentionSelectedIndex = 0;
  let mentionDebounceTimer = null;

  function closeMentionMenu() {
    mentionPopup.style.display = 'none';
    activeMentionTarget = null;
    mentionOptions = [];
    mentionSelectedIndex = 0;
  }

  function renderMentionMenu() {
    if (mentionOptions.length === 0) {
      closeMentionMenu();
      return;
    }

    const targetContainer = activeMentionTarget ? (activeMentionTarget.closest('dialog') || document.body) : document.body;
    if (mentionPopup.parentElement !== targetContainer) {
      targetContainer.appendChild(mentionPopup);
    }

    mentionPopup.innerHTML = '';
    mentionOptions.forEach((author, idx) => {
      const item = document.createElement('div');
      item.className = 'mention-autocomplete-item' + (idx === mentionSelectedIndex ? ' active' : '');
      item.onclick = (e) => {
        e.preventDefault();
        insertMention(author.author_name);
      };
      item.onmouseenter = () => {
        mentionSelectedIndex = idx;
        renderMentionMenu();
      };

      let avatarHtml = avatarFor(author.provider, author.provider_user_id || '', author.author_name, author.avatar_url);
      avatarHtml = avatarHtml.replace('comment-avatar-slot', 'mention-autocomplete-avatar');
      const providerClass = 'provider-' + esc(author.provider);
      
      item.innerHTML = `
        ${avatarHtml}
        <span class="mention-autocomplete-name">${esc(author.author_name)}</span>
        <span class="provider-tag ${providerClass}">${esc(author.provider)}</span>
      `;
      mentionPopup.appendChild(item);
    });
    
    mentionPopup.style.display = 'flex';

    if (activeMentionTarget) {
      const rect = activeMentionTarget.getBoundingClientRect();
      const inDialog = targetContainer !== document.body;

      if (inDialog) {
        // Modal dialog: calculate position relative to the dialog bounds
        const dialogRect = targetContainer.getBoundingClientRect();
        let topPos = (rect.top - dialogRect.top) - mentionPopup.offsetHeight - 8;
        if (topPos < 10) {
          topPos = (rect.bottom - dialogRect.top) + 8;
        }
        mentionPopup.style.left = (rect.left - dialogRect.left) + 'px';
        mentionPopup.style.top = topPos + 'px';
      } else {
        // Main document: calculate position relative to whole document page
        let topPos = rect.top + window.scrollY - mentionPopup.offsetHeight - 8;
        if (rect.top - mentionPopup.offsetHeight - 8 < 10) {
          topPos = rect.bottom + window.scrollY + 8;
        }
        mentionPopup.style.left = (rect.left + window.scrollX) + 'px';
        mentionPopup.style.top = topPos + 'px';
      }

      mentionPopup.style.width = rect.width + 'px';
    }
  }

  async function fetchAuthors(query) {
    try {
      const res = await fetch(`/.netlify/functions/search-authors?q=${encodeURIComponent(query)}`);
      if (!res.ok) return;
      const data = await res.json();
      mentionOptions = data.authors || [];
      mentionSelectedIndex = 0;
      renderMentionMenu();
    } catch (err) {
      console.error('Error fetching authors:', err);
    }
  }

  function insertMention(name) {
    if (!activeMentionTarget) return;
    const targetArea = activeMentionTarget;
    const text = targetArea.value;
    const cursor = targetArea.selectionStart;

    const textBefore = text.slice(0, cursor).replace(/\[@([^\]]*)$/, `[@${name}] `);
    const textAfter = text.slice(cursor);

    targetArea.value = textBefore + textAfter;
    targetArea.selectionStart = targetArea.selectionEnd = textBefore.length;
    targetArea.focus();
    closeMentionMenu();

    // Trigger an input event so the markdown preview reflects changes instantly
    targetArea.dispatchEvent(new Event('input', { bubbles: true }));
  }

  function handleMentionInput(e) {
    const targetArea = e.target;
    const text = targetArea.value;
    const cursor = targetArea.selectionStart;
    const textBeforeCursor = text.slice(0, cursor);

    // Look for [@ followed by characters right up to the cursor position
    const match = textBeforeCursor.match(/\[@([^\]]*)$/);

    if (match) {
      activeMentionTarget = targetArea;
      const query = match[1];
      clearTimeout(mentionDebounceTimer);
      mentionDebounceTimer = setTimeout(() => fetchAuthors(query), 200);
    } else {
      closeMentionMenu();
    }
  }

  function handleMentionKeydown(e) {
    if (mentionPopup.style.display === 'none') return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      mentionSelectedIndex = (mentionSelectedIndex + 1) % mentionOptions.length;
      renderMentionMenu();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      mentionSelectedIndex = (mentionSelectedIndex - 1 + mentionOptions.length) % mentionOptions.length;
      renderMentionMenu();
    } else if (e.key === 'Enter' || e.key === 'Tab') {
      e.preventDefault();
      if (mentionOptions[mentionSelectedIndex]) {
        insertMention(mentionOptions[mentionSelectedIndex].author_name);
      }
    } else if (e.key === 'Escape') {
      e.preventDefault();
      closeMentionMenu();
    }
  }

  // Attach the interactive triggers to the main and reply textareas
  [textarea, threadReplyInput].forEach(t => {
    if (t) {
      t.addEventListener('input', handleMentionInput);
      t.addEventListener('keydown', handleMentionKeydown);
      t.addEventListener('click', handleMentionInput); 
    }
  });

  // Soft dismiss when clicking away from the input or the popup
  document.addEventListener('click', (e) => {
    if (activeMentionTarget && e.target !== activeMentionTarget && !mentionPopup.contains(e.target)) {
      closeMentionMenu();
    }
  });

  // Close when modal closes
  threadDialog?.addEventListener('close', closeMentionMenu);
});
</script>

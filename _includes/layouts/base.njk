				<button type="button" id="lexicon-popover-close" class="lexicon-popover-close" aria-label="Close"><svg class="close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5L19 19M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>

<!doctype html>
<html {% if section %} data-current="{{ section }}"{% endif %} lang="en">

	{% include "components/head.njk" %}

	{% set themeClass = "rainbow-theme" %}

	{% if serious or '/tags/serious/' in page.url %}
		{% set themeClass = "serious-theme" %}

	{% elif lecture or '/tags/lecture/' in page.url %}
		{% set themeClass = "lecture-theme" %}
		
	{% elif tags and "satire" in tags or '/tags/satire/' in page.url %}
		{% set themeClass = "satire-theme" %}

	{% elif page.url == '/news/' or '/authors/' in page.url or '/tags/' in page.url %}
		{% set themeClass = "neutral-theme" %}
	{% endif %}

	<body class="{{ themeClass }}">

	<!-- Prevent Flash of Light Theme & Outlines -->
	<script>
	if (localStorage.getItem('theme') === 'dark') {
		document.body.classList.add('dark-mode');
	}
	if (localStorage.getItem('outlines') === 'enabled') {
		document.body.classList.add('show-outlines');
	}
	if (localStorage.getItem('dyslexic-font') === 'enabled') {
		document.body.classList.add('show-dyslexic-font');
	}
	</script>

		<header>
			<div class="content-wrapper" style="position: relative;"> 
				
				{# Header Controls: Lines Toggle & Dark Mode & OpenDyslexic #}
				<div class="header-controls-wrapper">
					<div class="control-group">
						<span class="control-label">Outlines</span>
						<label class="theme-switch" for="outline-toggle" aria-label="Toggle Main Container Outlines">
							<input type="checkbox" id="outline-toggle">
							<div class="slider"></div>
						</label>
					</div>
					<div class="control-group">
						<span class="control-label">Dark Mode</span>
						<label class="theme-switch" for="dark-mode-toggle" aria-label="Toggle Dark Mode">
							<input type="checkbox" id="dark-mode-toggle">
							<div class="slider"></div>
						</label>
					</div>
					<div class="control-group">
						<span class="control-label">Dyslexia</span>
						<label class="theme-switch" for="dyslexia-toggle" aria-label="Toggle OpenDyslexic Font">
							<input type="checkbox" id="dyslexia-toggle">
							<div class="slider"></div>
						</label>
					</div>
				</div>

				<em>
					<a href="{{ '/' | url }}">{{ metadata.title }}</a>
				</em>
				{% include "components/nav.njk" %}
				{# {% include "components/a-ads.njk" %} #}
			</div>
		</header>

		<main>
			{{ layoutContent | safe }}
		</main>

		{# The existing footer has text-align: center, which might be enough.
		   If its content still looks off, we can wrap its inner content
		   with <div class="content-wrapper"> too. Let's see first. #}
		{% include "components/footer.njk" %}

		<script src='https://storage.ko-fi.com/cdn/scripts/overlay-widget.js'></script>
		<script>
		// Outline Toggle State & Listener
		const outlineToggle = document.querySelector('#outline-toggle');
		const savedOutlines = localStorage.getItem('outlines');

		if (savedOutlines === 'enabled') {
			outlineToggle.checked = true;
		}

		outlineToggle.addEventListener('change', () => {
			if (outlineToggle.checked) {
				body.classList.add('show-outlines');
				localStorage.setItem('outlines', 'enabled');
			} else {
				body.classList.remove('show-outlines');
				localStorage.setItem('outlines', 'disabled');
			}
		});

		// Dark Mode Toggle
		const toggle = document.querySelector('#dark-mode-toggle');
		const body = document.body;
		const savedTheme = localStorage.getItem('theme');

		// Acquire Window Colors
		var bodyArchive = window.getComputedStyle(document.body);

		// 1. Initial State Setting
		if (savedTheme === 'dark') {
			toggle.checked = true;
		}

		// 2. Centralized Ko-fi Render Function
		function drawKofi() {
			var bodyPrimColor = bodyArchive.getPropertyValue('--primary');
			var bodySecColor = bodyArchive.getPropertyValue('--secondary');
			var activeBg = bodyPrimColor;
			var activeText = bodySecColor;

			if (body.classList.contains('rainbow-theme')) {
				if (body.classList.contains('dark-mode')) {
					activeBg = '#efefef';
					activeText = '#1a202c';
				} else {
					activeBg = '#1a202c';
					activeText = '#efefef';
				}
			}

			// Safely wipe any existing Ko-fi elements to prevent duplicates
			document.querySelectorAll('.floatingchat-container-wrap, iframe[id^="kofi-wo-window"]').forEach(el => el.remove());

			// Redraw the widget with the exact active color
			kofiWidgetOverlay.draw('creativealloy', {
				'type': 'floating-chat',
				'floating-chat.donateButton.text': 'Tip Me',
				'floating-chat.donateButton.background-color': activeBg, 
				'floating-chat.donateButton.text-color': activeText
			});
		}

		// 3. Draw on Page Load
		drawKofi();

		// 4. Handle Theme Switch
		toggle.addEventListener('change', () => {
			if (toggle.checked) {
			body.classList.add('dark-mode');
			localStorage.setItem('theme', 'dark');
			} else {
			body.classList.remove('dark-mode');
			localStorage.setItem('theme', 'light');
			}
			
			// Redraw button immediately after the CSS variables update
			setTimeout(drawKofi, 50);
		});

		// OpenDyslexic Toggle
		const dyslexiaToggle = document.querySelector('#dyslexia-toggle');
		const savedDyslexia = localStorage.getItem('dyslexic-font');

		if (savedDyslexia === 'enabled') {
			dyslexiaToggle.checked = true;
		}

		dyslexiaToggle.addEventListener('change', () => {
			if (dyslexiaToggle.checked) {
				body.classList.add('show-dyslexic-font');
				localStorage.setItem('dyslexic-font', 'enabled');
			} else {
				body.classList.remove('show-dyslexic-font');
				localStorage.setItem('dyslexic-font', 'disabled');
			}
		});

		</script>

		{# --- Interactive Lexicon Backdrop & Popover --- #}
		<div id="lexicon-backdrop" class="lexicon-backdrop"></div>
		<div id="lexicon-popover" class="lexicon-popover" role="dialog" aria-hidden="true">
			<div class="lexicon-popover-header">
				<strong id="lexicon-popover-title">Term</strong>
				<button id="lexicon-popover-close" aria-label="Close">&times;</button>
			</div>
			<p id="lexicon-popover-body">Definition goes here.</p>
		</div>

		<script>
		document.addEventListener('DOMContentLoaded', () => {
			const backdrop = document.getElementById('lexicon-backdrop');
			const popover = document.getElementById('lexicon-popover');
			const title = document.getElementById('lexicon-popover-title');
			const bodyText = document.getElementById('lexicon-popover-body');
			const closeBtn = document.getElementById('lexicon-popover-close');

			function openPopover(target) {
				const term = target.getAttribute('data-term') || target.textContent.trim();
				const definition = target.getAttribute('data-definition');
				if (!definition) return;

				title.textContent = term;
				bodyText.innerHTML = definition.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');

				// 1. Mobile & Small Tablets: Let CSS center it as a clean dialog
				if (window.innerWidth <= 600) {
					popover.style.top = '';
					popover.style.left = '';
					popover.classList.remove('popover-below');
				} else {
					// 2. Desktop: Viewport-clamped positioning
					const rect = target.getBoundingClientRect();
					const scrollY = window.scrollY || document.documentElement.scrollTop;
					const padding = 16;
					const popoverWidth = 340; // matches max-width in CSS
					const halfWidth = popoverWidth / 2;

					// Clamp horizontally so it never bleeds off left or right edges
					let targetX = rect.left + (rect.width / 2);
					if (targetX - halfWidth < padding) {
						targetX = halfWidth + padding;
					} else if (targetX + halfWidth > window.innerWidth - padding) {
						targetX = window.innerWidth - halfWidth - padding;
					}

					popover.style.left = `${targetX}px`;

					// Flip below if too close to top of viewport
					if (rect.top < 220) {
						popover.style.top = `${rect.bottom + scrollY + 12}px`;
						popover.classList.add('popover-below');
					} else {
						popover.style.top = `${rect.top + scrollY - 12}px`;
						popover.classList.remove('popover-below');
					}
				}

				backdrop.classList.add('active');
				popover.classList.add('active');
				popover.setAttribute('aria-hidden', 'false');
			}

			function closePopover() {
				backdrop.classList.remove('active');
				popover.classList.remove('active');
				popover.setAttribute('aria-hidden', 'true');
			}

			document.addEventListener('click', (e) => {
				const termElem = e.target.closest('.lexicon-term');
				if (termElem) {
					e.preventDefault();
					openPopover(termElem);
				} else if (e.target === backdrop || e.target === closeBtn) {
					closePopover();
				}
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') closePopover();
			});
		});
		</script>

        <script>
          window.MathJax = {
            tex: {
              inlineMath: [['$', '$'], ['\\(', '\\)']],
              displayMath: [['$$', '$$'], ['\\[', '\\]']]
            }
          };
        </script>
        <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

		{# --- Custom Audio Player Controller --- #}
		<script>
		document.addEventListener('DOMContentLoaded', () => {
			document.querySelectorAll('.custom-audio-player').forEach(player => {
				const audio = player.querySelector('audio');
				const playBtn = player.querySelector('.audio-play-btn');
				const playIcon = playBtn ? playBtn.querySelector('.play-icon') : null;
				const pauseIcon = playBtn ? playBtn.querySelector('.pause-icon') : null;
				const seekBar = player.querySelector('.audio-seek-bar');
				const timeCurrent = player.querySelector('.time-current');
				const timeDuration = player.querySelector('.time-duration');
				const muteBtn = player.querySelector('.audio-mute-btn');
				const volIcon = muteBtn ? muteBtn.querySelector('.vol-icon') : null;
				const muteIcon = muteBtn ? muteBtn.querySelector('.mute-icon') : null;

				if (!audio) return;

				function formatTime(seconds) {
					if (isNaN(seconds) || seconds < 0) return '0:00';
					const mins = Math.floor(seconds / 60);
					const secs = Math.floor(seconds % 60);
					return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
				}

				function updateDuration() {
					if (timeDuration && !isNaN(audio.duration) && audio.duration > 0) {
						timeDuration.textContent = formatTime(audio.duration);
					}
				}

				audio.addEventListener('loadedmetadata', updateDuration);
				audio.addEventListener('durationchange', updateDuration);
				if (audio.readyState >= 1) updateDuration();

				if (playBtn) {
					playBtn.addEventListener('click', () => {
						if (audio.paused) {
							document.querySelectorAll('.custom-audio-player audio').forEach(a => {
								if (a !== audio) a.pause();
							});
							audio.play();
						} else {
							audio.pause();
						}
					});
				}

				audio.addEventListener('play', () => {
					if (playIcon) playIcon.style.display = 'none';
					if (pauseIcon) pauseIcon.style.display = 'block';
				});

				audio.addEventListener('pause', () => {
					if (playIcon) playIcon.style.display = 'block';
					if (pauseIcon) pauseIcon.style.display = 'none';
				});

				audio.addEventListener('timeupdate', () => {
					if (!audio.duration) return;
					const progress = (audio.currentTime / audio.duration) * 100;
					if (seekBar) {
						seekBar.value = progress;
						seekBar.style.setProperty('--seek-progress', `${progress}%`);
					}
					if (timeCurrent) timeCurrent.textContent = formatTime(audio.currentTime);
				});

				audio.addEventListener('ended', () => {
					if (playIcon) playIcon.style.display = 'block';
					if (pauseIcon) pauseIcon.style.display = 'none';
					if (seekBar) {
						seekBar.value = 0;
						seekBar.style.setProperty('--seek-progress', '0%');
					}
					if (timeCurrent) timeCurrent.textContent = '0:00';
				});

				if (seekBar) {
					seekBar.addEventListener('input', (e) => {
						seekBar.style.setProperty('--seek-progress', `${e.target.value}%`);
						if (!audio.duration) return;
						const seekTo = (e.target.value / 100) * audio.duration;
						audio.currentTime = seekTo;
					});
				}

				if (muteBtn) {
					muteBtn.addEventListener('click', () => {
						audio.muted = !audio.muted;
						if (audio.muted) {
							if (volIcon) volIcon.style.display = 'none';
							if (muteIcon) muteIcon.style.display = 'block';
						} else {
							if (volIcon) volIcon.style.display = 'block';
							if (muteIcon) muteIcon.style.display = 'none';
						}
					});
				}
			});
		});
		</script>

	</body>

</html>

<!doctype html>
<html {% if section %} data-current="{{ section }}"{% endif %} lang="en">

	{% include "components/head.njk" %}

	{% set themeClass = "rainbow-theme" %}

	{% if archive or '/tags/archive/' in page.url or '/archives/' in page.url or (tags and "archive" in tags) %}
		{% set themeClass = "archive-theme" %}

	{% elif serious or '/tags/serious/' in page.url %}
		{% set themeClass = "serious-theme" %}

	{% elif lecture or '/tags/lecture/' in page.url %}
		{% set themeClass = "lecture-theme" %}
		
	{% elif tags and "satire" in tags or '/tags/satire/' in page.url %}
		{% set themeClass = "satire-theme" %}

	{% elif page.url == '/news/' or '/authors/' in page.url or '/tags/' in page.url or page.url == '/' %}
		{% set themeClass = "neutral-theme" %}
	{% endif %}

	<body class="{{ themeClass }}">

	<!-- Prevent Flash of Light Theme & Outlines -->
	<script>
	if (localStorage.getItem('theme') === 'dark') {
		document.body.classList.add('dark-mode');
	}
	if (localStorage.getItem('outlines') === 'enabled') {
		document.body.classList.add('show-outlines');
	}
	if (localStorage.getItem('dyslexic-font') === 'enabled') {
		document.body.classList.add('show-dyslexic-font');
	}
	</script>

		<header>
			<div class="content-wrapper" style="position: relative;"> 
				
				{# Header Controls: Lines Toggle & Dark Mode & OpenDyslexic #}
				<div class="header-controls-wrapper">
					<div class="control-group">
						<span class="control-label">Outlines</span>
						<label class="theme-switch" for="outline-toggle" aria-label="Toggle Main Container Outlines">
							<input type="checkbox" id="outline-toggle">
							<div class="slider"></div>
						</label>
					</div>
					<div class="control-group">
						<span class="control-label">Dark Mode</span>
						<label class="theme-switch" for="dark-mode-toggle" aria-label="Toggle Dark Mode">
							<input type="checkbox" id="dark-mode-toggle">
							<div class="slider"></div>
						</label>
					</div>
					<div class="control-group">
						<span class="control-label">Dyslexia</span>
						<label class="theme-switch" for="dyslexia-toggle" aria-label="Toggle OpenDyslexic Font">
							<input type="checkbox" id="dyslexia-toggle">
							<div class="slider"></div>
						</label>
					</div>
				</div>

				<em>
					<a href="{{ '/' | url }}">{{ metadata.title }}</a>
				</em>
				{% include "components/nav.njk" %}
				{# {% include "components/a-ads.njk" %} #}
			</div>
		</header>

		<main>
			{{ layoutContent | safe }}
		</main>

		{# The existing footer has text-align: center, which might be enough.
		   If its content still looks off, we can wrap its inner content
		   with <div class="content-wrapper"> too. Let's see first. #}
		{% include "components/footer.njk" %}

		<script src='https://storage.ko-fi.com/cdn/scripts/overlay-widget.js'></script>
		<script>
		// Outline Toggle State & Listener
		const outlineToggle = document.querySelector('#outline-toggle');
		const savedOutlines = localStorage.getItem('outlines');

		if (savedOutlines === 'enabled') {
			outlineToggle.checked = true;
		}

		outlineToggle.addEventListener('change', () => {
			if (outlineToggle.checked) {
				body.classList.add('show-outlines');
				localStorage.setItem('outlines', 'enabled');
			} else {
				body.classList.remove('show-outlines');
				localStorage.setItem('outlines', 'disabled');
			}
		});

		// Dark Mode Toggle
		const toggle = document.querySelector('#dark-mode-toggle');
		const body = document.body;
		const savedTheme = localStorage.getItem('theme');

		// Acquire Window Colors
		var bodyArchive = window.getComputedStyle(document.body);

		// 1. Initial State Setting
		if (savedTheme === 'dark') {
			toggle.checked = true;
		}

		// 2. Centralized Ko-fi Render Function
		function drawKofi() {
			var bodyPrimColor = bodyArchive.getPropertyValue('--primary');
			var bodySecColor = bodyArchive.getPropertyValue('--secondary');
			var activeBg = bodyPrimColor;
			var activeText = bodySecColor;

			if (body.classList.contains('rainbow-theme')) {
				if (body.classList.contains('dark-mode')) {
					activeBg = '#efefef';
					activeText = '#1a202c';
				} else {
					activeBg = '#1a202c';
					activeText = '#efefef';
				}
			}

			// Safely wipe any existing Ko-fi elements to prevent duplicates
			document.querySelectorAll('.floatingchat-container-wrap, iframe[id^="kofi-wo-window"]').forEach(el => el.remove());

			// Redraw the widget with the exact active color
			kofiWidgetOverlay.draw('creativealloy', {
				'type': 'floating-chat',
				'floating-chat.donateButton.text': 'Tip Me',
				'floating-chat.donateButton.background-color': activeBg, 
				'floating-chat.donateButton.text-color': activeText
			});
		}

		// 3. Draw on Page Load
		drawKofi();

		// 4. Handle Theme Switch
		toggle.addEventListener('change', () => {
			if (toggle.checked) {
			body.classList.add('dark-mode');
			localStorage.setItem('theme', 'dark');
			} else {
			body.classList.remove('dark-mode');
			localStorage.setItem('theme', 'light');
			}
			
			// Redraw button immediately after the CSS variables update
			setTimeout(drawKofi, 50);
		});

		// OpenDyslexic Toggle
		const dyslexiaToggle = document.querySelector('#dyslexia-toggle');
		const savedDyslexia = localStorage.getItem('dyslexic-font');

		if (savedDyslexia === 'enabled') {
			dyslexiaToggle.checked = true;
		}

		dyslexiaToggle.addEventListener('change', () => {
			if (dyslexiaToggle.checked) {
				body.classList.add('show-dyslexic-font');
				localStorage.setItem('dyslexic-font', 'enabled');
			} else {
				body.classList.remove('show-dyslexic-font');
				localStorage.setItem('dyslexic-font', 'disabled');
			}
		});

		</script>

		{# =========================================================================
   GLOBAL AUTH + NOTIFICATIONS (rendered on every page)
   Shared session lives in localStorage 'twa_user'. Article pages talk to this
   engine through window.TWA (see comments.njk).
   ========================================================================= #}
<div id="twa-fab-cluster" class="twa-fab-cluster" role="group" aria-label="Account and notifications">
	<div id="twa-account" class="twa-account"><!-- Sign In button OR avatar chip, filled by JS --></div>
	<button type="button" id="notif-bell" class="notif-bell" aria-label="Notifications" aria-haspopup="dialog" aria-expanded="false" aria-controls="notifications-drawer" hidden>
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2a6 6 0 0 0-6 6v3.6c0 .5-.2 1-.5 1.4L4 14.8c-.7.9-.1 2.2 1 2.2h14c1.1 0 1.7-1.3 1-2.2l-1.5-1.8c-.3-.4-.5-.9-.5-1.4V8a6 6 0 0 0-6-6zm0 20a3 3 0 0 0 3-3H9a3 3 0 0 0 3 3z"/></svg>
		<span class="notif-badge" id="notif-badge" hidden>0</span>
	</button>
</div>

<div id="notif-backdrop" class="notif-backdrop"></div>

<aside id="notifications-drawer" class="notif-drawer" role="dialog" aria-modal="true" aria-labelledby="notif-title" inert>
	<header class="notif-drawer-header">
		<h4 id="notif-title">Notifications</h4>
		<div class="notif-drawer-actions">
			<button type="button" id="notif-mark-all" class="notif-mark-all" disabled>Mark all as read</button>
			<button type="button" id="notif-close" class="notif-close" aria-label="Close notifications"><svg class="close-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5L19 19M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
		</div>
	</header>
	<div id="notif-account" class="notif-account"><!-- avatar + handle + role + Log Out, filled by JS --></div>
	<div id="notif-list" class="notif-list" aria-live="polite">
		<!-- Mini comment cards render here -->
	</div>
</aside>

<dialog id="login-dialog" class="auth-dialog" aria-labelledby="login-dialog-title">
	<h4 id="login-dialog-title">Sign in</h4>
	<p>Choose how you'd like to sign in. Signing in lets you comment, rate, and get notified about replies.</p>
	<div class="auth-dialog-options">
		<button type="button" class="auth-pill auth-btn-github" data-provider="github">Sign in with GitHub</button>
		<button type="button" class="auth-pill auth-btn-instagram" data-provider="instagram">Sign in with Instagram</button>
		<button type="button" class="auth-pill auth-btn-discord" data-provider="discord">Sign in with Discord</button>
	</div>
	<button type="button" class="auth-dialog-cancel" id="login-dialog-cancel">Cancel</button>
</dialog>

<script>
(function () {
	'use strict';

	const STORAGE_KEY = 'twa_user';
	const POST_URL = (slug) => `/posts/${encodeURIComponent(slug)}/`;

	const esc = (s) => String(s ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));

	const FLAG_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 21V3M5 4h12l-2.5 4L17 12H5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
	const SIGNIN_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';

	function avatarFor(provider, userId, name, avatarUrl) {
		if (avatarUrl) {
			return `<img src="${esc(avatarUrl)}" alt="${esc(name)}" class="comment-avatar-slot">`;
		}
		if (provider === 'github' && userId && userId !== 'guest') {
			return `<img src="https://avatars.githubusercontent.com/u/${encodeURIComponent(userId)}?v=4" alt="${esc(name)}" class="comment-avatar-slot">`;
		}
		const initial = esc((name || '?').charAt(0).toUpperCase());
		const providerClass = provider === 'discord' ? 'avatar-discord' : provider === 'instagram' ? 'avatar-instagram' : '';
		return `<div class="comment-avatar-slot ${providerClass}" aria-hidden="true">${initial}</div>`;
	}

	// ---------------------------------------------------------------------
	// Session
	// ---------------------------------------------------------------------
	function readStoredUser() {
		try {
			const u = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
			// Old or tampered sessions without a token count as logged out
			if (u && !u.token) { localStorage.removeItem(STORAGE_KEY); return null; }
			return u;
		} catch (err) {
			return null;
		}
	}

	let user = readStoredUser();
	const listeners = new Set();

	const accountEl = document.getElementById('twa-account');
	const drawerAccountEl = document.getElementById('notif-account');
	const loginDialog = document.getElementById('login-dialog');

	const notifBell = document.getElementById('notif-bell');
	const notifBadge = document.getElementById('notif-badge');
	const notifBackdrop = document.getElementById('notif-backdrop');
	const notifDrawer = document.getElementById('notifications-drawer');
	const notifList = document.getElementById('notif-list');
	const notifMarkAll = document.getElementById('notif-mark-all');
	const notifClose = document.getElementById('notif-close');
	const notifReady = !!(notifBell && notifBackdrop && notifDrawer && notifList && notifMarkAll && notifClose);

	let notifications = [];
	let notifUnread = 0;

	const authHeaders = () => ({
		'Content-Type': 'application/json',
		'Authorization': `Bearer ${user?.token || ''}`
	});

	function setUser(next) {
		user = next || null;
		try {
			if (user) localStorage.setItem(STORAGE_KEY, JSON.stringify(user));
			else localStorage.removeItem(STORAGE_KEY);
		} catch (err) { /* storage blocked: session lasts for this page only */ }
		userChanged();
	}

	function userChanged() {
		renderAccount();
		syncNotifUI();
		listeners.forEach(fn => { try { fn(user); } catch (err) { console.error(err); } });
	}

	function logout() { setUser(null); }

	// A 401 from any endpoint lands here. silent = no alert (used for background fetches)
	function handleExpired(silent) {
		setUser(null);
		if (!silent) alert('Your session expired. Please sign in again.');
	}

	function openLogin() {
		if (loginDialog && !loginDialog.open) loginDialog.showModal();
	}

	// ---------------------------------------------------------------------
	// Login dialog
	// ---------------------------------------------------------------------
	if (loginDialog) {
		loginDialog.querySelectorAll('[data-provider]').forEach(btn => {
			btn.addEventListener('click', () => {
				window.open(`/.netlify/functions/auth?action=login&provider=${btn.dataset.provider}`, 'twaAuth', 'width=500,height=600');
				loginDialog.close();
			});
		});
		document.getElementById('login-dialog-cancel')?.addEventListener('click', () => loginDialog.close());
		loginDialog.addEventListener('click', (e) => { if (e.target === loginDialog) loginDialog.close(); });
	}

	// Secure payload from the OAuth popup
	window.addEventListener('message', (event) => {
		if (event.origin !== window.location.origin) return;
		if (event.data && event.data.type === 'TWA_AUTH_SUCCESS') setUser(event.data.data);
	});

	// Sign in / out in another tab keeps this one in sync
	window.addEventListener('storage', (e) => {
		if (e.key !== STORAGE_KEY && e.key !== null) return;
		user = readStoredUser();
		userChanged();
	});

	// ---------------------------------------------------------------------
	// Floating account chip + drawer account row
	// ---------------------------------------------------------------------
	function roleBadgeHtml() {
		if (user?.role === 'moderator') return '<span class="provider-tag role-admin">Admin</span>';
		if (user?.role === 'author') return '<span class="provider-tag role-author">Author</span>';
		return '';
	}

	function userAvatarHtml() {
		if (user.avatar_url) return `<img src="${esc(user.avatar_url)}" alt="" class="auth-user-avatar">`;
		return `<span class="auth-user-avatar avatar-${esc(user.provider)}" aria-hidden="true">${esc((user.username || '?').charAt(0).toUpperCase())}</span>`;
	}

	function renderAccount() {
		if (accountEl) {
			if (user) {
				const name = user.username || 'Account';
				accountEl.innerHTML = `
					<div class="twa-account-chip">
						<button type="button" class="twa-account-open" data-twa-action="open-drawer" aria-label="${esc(name)}: open account and notifications">
							${userAvatarHtml()}
							<span class="twa-account-name">${esc(name)}</span>
							${roleBadgeHtml()}
						</button>
						<button type="button" class="btn-logout" data-twa-action="logout">Log Out</button>
					</div>`;
			} else {
				accountEl.innerHTML = `
					<button type="button" class="twa-account-btn" data-twa-action="login" aria-haspopup="dialog">
						${SIGNIN_SVG}<span class="twa-account-label">Sign In</span>
					</button>`;
			}
		}

		if (drawerAccountEl) {
			drawerAccountEl.innerHTML = user ? `
				${userAvatarHtml()}
				<span class="auth-pill provider-${esc(user.provider)}">${esc(user.username || 'Account')}</span>
				${roleBadgeHtml()}
				<button type="button" class="btn-logout" data-twa-action="logout">Log Out</button>` : '';
		}
	}

	// One delegated listener drives every sign-in / log-out / drawer button on the site,
	// including the ones rendered later by comments.njk.
	document.addEventListener('click', (e) => {
		const trigger = e.target.closest('[data-twa-action]');
		if (!trigger) return;
		const action = trigger.dataset.twaAction;
		if (action === 'login') openLogin();
		else if (action === 'logout') {
			// Native confirm, same as the comment-delete prompt; Cancel leaves the session untouched
			const name = user?.username || 'your account';
			if (confirm(`Are you sure you want to log out, ${name}?`)) logout();
		}
		else if (action === 'open-drawer') openNotifDrawer();
	});

	// ---------------------------------------------------------------------
	// Notifications
	// ---------------------------------------------------------------------
	const relTime = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
	function timeAgo(iso) {
		const secs = Math.round((new Date(iso).getTime() - Date.now()) / 1000);
		const units = [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]];
		for (const [unit, size] of units) {
			if (Math.abs(secs) >= size) return relTime.format(Math.round(secs / size), unit);
		}
		return 'just now';
	}

	// Markdown -> plain text without needing marked/DOMPurify on every page
	// (output is always passed through esc() before it touches innerHTML)
	function notifSnippet(md) {
		return String(md || '')
			.replace(/```[\s\S]*?```/g, ' ')
			.replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
			.replace(/\[@([^\]]+)\]/g, '@$1')
			.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
			.replace(/<[^>]+>/g, ' ')
			.replace(/^[>#\s*+-]+/gm, '')
			.replace(/[*_`~]+/g, '')
			.replace(/\s+/g, ' ')
			.trim();
	}

	// Deep link into an article: the post page reads these params and opens the thread
	function deepLink(n) {
		const q = new URLSearchParams();
		if (n.kind !== 'report') q.set('thread', n.parent_id);
		q.set('target_comment', n.reply_id);
		q.set('parent', n.parent_id);
		return `${POST_URL(n.post_slug)}?${q.toString()}`;
	}

	function updateBadge() {
		if (!notifBadge || !notifBell) return;
		notifBadge.textContent = notifUnread > 99 ? '99+' : String(notifUnread);
		notifBadge.hidden = notifUnread <= 0;
		notifBell.setAttribute('aria-label', notifUnread > 0 ? `Notifications (${notifUnread} unread)` : 'Notifications');
	}

	function buildNotifCard(n) {
		const card = document.createElement('article');
		card.className = 'notif-card' + (n.is_read ? '' : ' unread');
		card.setAttribute('data-id', n.id);

		if (n.kind === 'report') {
			card.classList.add('notif-report');
			card.innerHTML = `
				<header class="notif-card-header">
					<span class="notif-report-icon" aria-hidden="true">${FLAG_SVG}</span>
					<div class="notif-card-meta">
						<strong class="comment-author">${esc(n.reporter_name || 'A reader')}</strong>
						<span class="notif-report-badge">[REPORT: ${esc(n.report_reason)}]</span>
						<time datetime="${esc(n.created_at)}"><small>${esc(timeAgo(n.created_at))}</small></time>
					</div>
					${n.is_read ? '' : '<span class="notif-dot" role="img" aria-label="Unread"></span>'}
				</header>
				<p class="notif-snippet">Comment by ${esc(n.author_name)}: ${esc(notifSnippet(n.comment_body))}</p>
				<a class="notif-report-link" href="${esc(deepLink(n))}">[Review Reported Comment]</a>
			`;
			return card;
		}

		const authorHtml = n.author_url
			? `<a href="${esc(n.author_url)}" target="_blank" rel="noopener noreferrer" class="comment-author-link"><strong class="comment-author">${esc(n.author_name)}</strong></a>`
			: `<strong class="comment-author">${esc(n.author_name)}</strong>`;

		card.innerHTML = `
			<header class="notif-card-header">
				${avatarFor(n.provider, n.provider_user_id, n.author_name, n.avatar_url)}
				<div class="notif-card-meta">
					${authorHtml}
					<span class="provider-tag provider-${esc(n.provider)}">${esc(n.provider)}</span>
					<time datetime="${esc(n.created_at)}"><small>${esc(timeAgo(n.created_at))}</small></time>
				</div>
				${n.is_read ? '' : '<span class="notif-dot" role="img" aria-label="Unread"></span>'}
			</header>
			<button type="button" class="notif-card-open" title="Open thread">
				<span class="notif-snippet">${esc(notifSnippet(n.comment_body))}</span>
			</button>
		`;
		return card;
	}

	function renderNotifications() {
		if (!notifReady) return;
		notifList.innerHTML = '';
		if (notifications.length === 0) {
			notifList.innerHTML = '<p class="notif-empty"><em>No notifications yet.</em></p>';
		} else {
			notifications.forEach(n => notifList.appendChild(buildNotifCard(n)));
		}
		notifMarkAll.disabled = notifUnread === 0;
		updateBadge();
	}

	async function fetchNotifications() {
		if (!notifReady || !user) return;
		try {
			const res = await fetch('/.netlify/functions/get-notifications', { headers: authHeaders() });
			if (res.status === 401) { handleExpired(true); return; } // quiet sign-out, no alert on page load
			if (!res.ok) return;
			const data = await res.json();
			notifications = data.notifications || [];
			notifUnread = Number(data.unread_count) || 0;
			renderNotifications();
		} catch (err) {
			console.error('Failed to load notifications:', err);
		}
	}

	// keepalive so a mark-read still completes when we navigate away right after
	async function markNotificationsRead(payload) {
		try {
			const res = await fetch('/.netlify/functions/mark-notifications-read', {
				method: 'POST',
				headers: authHeaders(),
				body: JSON.stringify(payload),
				keepalive: true
			});
			if (res.status === 401) { handleExpired(false); return false; }
			return res.ok;
		} catch (err) {
			console.error('Failed to mark notifications read:', err);
			return false;
		}
	}

	function openNotifDrawer() {
		if (!notifReady || !user) return;
		notifDrawer.removeAttribute('inert');
		notifDrawer.classList.add('open');
		notifBackdrop.classList.add('open');
		notifBell.setAttribute('aria-expanded', 'true');
		requestAnimationFrame(() => notifClose.focus());
		fetchNotifications();
	}

	function closeNotifDrawer() {
		if (!notifReady) return;
		const wasOpen = notifDrawer.classList.contains('open');
		notifDrawer.classList.remove('open');
		notifBackdrop.classList.remove('open');
		notifDrawer.setAttribute('inert', '');
		notifBell.setAttribute('aria-expanded', 'false');
		if (wasOpen) notifBell.focus();
	}

	// Show/hide the bell and load the count
	function syncNotifUI() {
		if (!notifReady) return;
		if (user) {
			notifBell.hidden = false;
			fetchNotifications();
		} else {
			closeNotifDrawer();
			notifBell.hidden = true;
			notifications = [];
			notifUnread = 0;
			renderNotifications();
		}
	}

	function openNotification(n) {
		if (!n.is_read) {
			n.is_read = true;
			notifUnread = Math.max(0, notifUnread - 1);
			markNotificationsRead({ notification_id: n.id });
		}

		// Already on that article: refresh, then open the thread and red-glow the comment in place
		const page = window.TWA.page;
		if (page && page.slug === n.post_slug) {
			closeNotifDrawer();
			renderNotifications();
			Promise.resolve(page.reload()).then(() => {
				if (!page.focusComment(n.reply_id)) page.openThread(n.parent_id);
			});
			return;
		}

		// Anywhere else (Home, News, About, tag pages...): go to the article. Its comments
		// script reads ?thread / ?target_comment on load and opens the thread dialog.
		window.location.href = deepLink(n);
	}

	if (notifReady) {
		notifBell.addEventListener('click', () => {
			if (notifDrawer.classList.contains('open')) closeNotifDrawer(); else openNotifDrawer();
		});
		notifClose.addEventListener('click', closeNotifDrawer);
		notifBackdrop.addEventListener('click', closeNotifDrawer);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && notifDrawer.classList.contains('open')) closeNotifDrawer();
		});

		notifMarkAll.addEventListener('click', async () => {
			if (notifUnread === 0) return;
			notifMarkAll.disabled = true;
			const ok = await markNotificationsRead({ all: true });
			if (ok) {
				notifications.forEach(n => { n.is_read = true; });
				notifUnread = 0;
				renderNotifications();
			} else {
				notifMarkAll.disabled = false;
			}
		});

		// Whole card is clickable (profile links keep working); the inner button covers the keyboard
		notifList.addEventListener('click', (e) => {
			const link = e.target.closest('a');
			if (link && (!link.classList.contains('notif-report-link') || e.metaKey || e.ctrlKey || e.shiftKey)) return;
			if (link) e.preventDefault();
			const card = e.target.closest('.notif-card');
			if (!card) return;
			const n = notifications.find(x => Number(x.id) === Number(card.dataset.id));
			if (n) openNotification(n);
		});

		// Pick up replies that arrived while the tab was in the background
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden && user) fetchNotifications();
		});
	}

	// ---------------------------------------------------------------------
	// Public API for page-level scripts (comments.njk)
	// ---------------------------------------------------------------------
	window.TWA = {
		getUser: () => user,
		authHeaders,
		openLogin,
		logout,
		handleExpired,
		onAuthChange: (fn) => { listeners.add(fn); return () => listeners.delete(fn); },
		esc,
		avatarFor,
		FLAG_SVG,
		// An article registers { slug, reload(), openThread(id), focusComment(id) } here
		page: null,
		registerPage: (ctx) => { window.TWA.page = ctx; }
	};

	// First paint (script sits at the end of <body>, so every element above already exists)
	renderAccount();
	syncNotifUI();
})();
</script>


		<script>
		document.addEventListener('DOMContentLoaded', () => {
			const backdrop = document.getElementById('lexicon-backdrop');
			const popover = document.getElementById('lexicon-popover');
			const title = document.getElementById('lexicon-popover-title');
			const bodyText = document.getElementById('lexicon-popover-body');
			const closeBtn = document.getElementById('lexicon-popover-close');

			function openPopover(target) {
				const term = target.getAttribute('data-term') || target.textContent.trim();
				const definition = target.getAttribute('data-definition');
				if (!definition) return;

				title.textContent = term;
				bodyText.innerHTML = definition.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');

				// 1. Mobile & Small Tablets: Let CSS center it as a clean dialog
				if (window.innerWidth <= 600) {
					popover.style.top = '';
					popover.style.left = '';
					popover.classList.remove('popover-below');
				} else {
					// 2. Desktop: Viewport-clamped positioning
					const rect = target.getBoundingClientRect();
					const scrollY = window.scrollY || document.documentElement.scrollTop;
					const padding = 16;
					const popoverWidth = 340;
					const halfWidth = popoverWidth / 2;

					// Clamp horizontally so it never bleeds off left or right edges
					let targetX = rect.left + (rect.width / 2);
					if (targetX - halfWidth < padding) {
						targetX = halfWidth + padding;
					} else if (targetX + halfWidth > window.innerWidth - padding) {
						targetX = window.innerWidth - halfWidth - padding;
					}

					popover.style.left = `${targetX}px`;

					// Measure the actual rendered height of the popover box
					const popoverHeight = popover.offsetHeight || 350;

					// Flip below if the space above the word is smaller than the card height + buffer
					if (rect.top < popoverHeight + 24) {
						popover.style.top = `${rect.bottom + scrollY + 12}px`;
						popover.classList.add('popover-below');
					} else {
						popover.style.top = `${rect.top + scrollY - 12}px`;
						popover.classList.remove('popover-below');
					}
				}

				backdrop.classList.add('active');
				popover.classList.add('active');
				popover.setAttribute('aria-hidden', 'false');
			}

			function closePopover() {
				backdrop.classList.remove('active');
				popover.classList.remove('active');
				popover.setAttribute('aria-hidden', 'true');
			}

			document.addEventListener('click', (e) => {
				const termElem = e.target.closest('.lexicon-term');
				if (termElem) {
					e.preventDefault();
					openPopover(termElem);
				} else if (e.target === backdrop || e.target === closeBtn) {
					closePopover();
				}
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') closePopover();
			});
		});
		</script>

